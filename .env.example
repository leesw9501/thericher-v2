# Engine mode defaults to off.
THERICHER_MODE=off

# Dashboard auth token should be set locally and never committed.
THERICHER_DASHBOARD_TOKEN=

# GPU/research model artifacts should stay outside the repo.
# Docker Compose accepts the slash form on Windows.
THERICHER_HOST_MODEL_ARTIFACT_ROOT=D:/thericher-v2/model-artifacts
THERICHER_MODEL_ARTIFACT_ROOT=/app/model_artifacts

# KIS credentials must stay local.
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIS_ACCOUNT_PRODUCT_CODE=
