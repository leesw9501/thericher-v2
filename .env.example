# Engine mode defaults to off.
THERICHER_MODE=off

# GPU/research model artifacts should stay outside the repo.
# Docker Compose accepts the slash form on Windows.
THERICHER_HOST_MODEL_ARTIFACT_ROOT=D:/thericher-v2/model-artifacts
THERICHER_MODEL_ARTIFACT_ROOT=/app/model_artifacts

# KIS virtual-paper credentials stay local. Authorized KIS Paper components may
# read only the paper values they need; no component may read KIS_LIVE_*.
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=

# Dashboard auth token should be set locally and never committed. Keep a
# nonempty value after the KIS app block so narrow KIS readers never inspect it.
THERICHER_DASHBOARD_TOKEN=

# KIS virtual-paper account values are used only by paper account/order work.
KIS_PAPER_ACCOUNT_NO=
KIS_PAPER_ACCOUNT_PRODUCT_CODE=

# Optional live credentials. Keep blank until live trading is intentionally enabled.
KIS_LIVE_APP_KEY=
KIS_LIVE_APP_SECRET=
KIS_LIVE_ACCOUNT_NO=
KIS_LIVE_ACCOUNT_PRODUCT_CODE=

TIINGO_API_TOKEN=
